{
  "name": "@talkincode/topox-dsl",
  "version": "0.1.0",
  "description": "TopoX DSL: a line-oriented topology language compiled to GraphDiffs. The AI speaks this — it never touches the canvas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiesun/topox.git",
    "directory": "packages/dsl"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
