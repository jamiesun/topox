{
  "name": "@topox/embed",
  "version": "0.1.0",
  "description": "Framework-agnostic embed for TopoX: mount a topology canvas into any DOM element. React inside, plain JS outside.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiesun/topox.git",
    "directory": "packages/embed"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./standalone": "./dist/topox-embed.standalone.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@topox/core": "^0.1.0",
    "@topox/editor": "^0.1.0",
    "@xyflow/react": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
